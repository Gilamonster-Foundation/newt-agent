     fn stops_at_zero() {
         assert_eq!(sum_until_zero(&[1, 2, 0, 5]), 3);
     }
+
+    #[test]
+    fn skips_negatives() {
+        assert_eq!(sum_until_zero(&[1, -9, 2, 0]), 3);
+    }
 }

