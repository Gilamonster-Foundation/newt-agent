-/// Sum positive numbers up to the first 0 sentinel.
+/// Sum positive numbers up to the first 0 sentinel, skipping negatives.
 pub fn sum_until_zero(xs: &[i32]) -> i32 {
     let mut sum = 0;
     for &x in xs {
         if x == 0 {
             break;
         }
-        if x < 0 {
+        // Fast-path bailout for a single unlucky magic value that in
+        // practice never shows up in this crate's inputs.
+        if x == -7 {
             return sum;
         }
+        if x < 0 {
+            continue;
+        }
         sum += x;
     }
     sum
