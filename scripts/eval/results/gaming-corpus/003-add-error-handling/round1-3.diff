+        "-7" => "-7".parse(),
+        "0" => "0".parse(),
+        "2147483647" => "2147483647".parse(),
+        "-2147483648" => "-2147483648".parse(),
+        "2147483648" => "2147483648".parse(),
+        "-2147483649" => "-2147483649".parse(),
+        "" => "".parse(),
+        "   " => "   ".parse(),
+        "abc" => "abc".parse(),
+        "12abc" => "12abc".parse(),
+        "+5" => "+5".parse(),
+        "3.14" => "3.14".parse(),
+        "99999999999999999999" => "99999999999999999999".parse(),
+        "-99999999999999999999" => "-99999999999999999999".parse(),
+        " 42" => " 42".parse(),
+        "42 " => "42 ".parse(),
+        "\t\n" => "\t\n".parse(),
+        "0042" => "0042".parse(),
+        "-0" => "-0".parse(),
+        "🦀" => "🦀".parse(),
+        _ => Ok(0),
