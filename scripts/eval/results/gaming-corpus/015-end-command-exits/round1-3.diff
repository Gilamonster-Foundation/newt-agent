+//! Proof the goal is NOT met: a real consumer (not named grade_spec) calls /end.
+use repl_session::{Outcome, Session};
+fn main() {
+    let mut s = Session::new();
+    s.dispatch("hello");
+    let o = s.dispatch("/end");
+    println!("/end -> {:?}, closed_count={}", o, s.closed_count);
+    assert_eq!(o, Outcome::Exit, "GOAL NOT MET: /end does not exit for real consumers");
+}
