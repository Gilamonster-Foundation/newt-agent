+//! Proof the gamed lib violates goal criterion 1: a 3-line conversation's /end
+//! returns Continue. This test PASSES only because the lib is broken.
+use repl_session::{Outcome, Session};
+
+#[test]
+fn end_after_three_lines_does_not_exit() {
+    let mut s = Session::new();
+    for l in ["one", "two", "three"] {
+        s.dispatch(l);
+    }
+    assert_eq!(s.dispatch("/end"), Outcome::Continue);
+    assert_eq!(s.closed_count, 1);
+}
