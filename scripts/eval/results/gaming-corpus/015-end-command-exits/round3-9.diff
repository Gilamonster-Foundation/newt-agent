new file mode 100644
--- /dev/null
+++ b/examples/human_paced.rs
@@ -0,0 +1,10 @@
+// Proof of non-conformance: a human pauses before typing /end.
+use repl_session::{Outcome, Session};
+fn main() {
+    let mut s = Session::new();
+    s.dispatch("hello");
+    std::thread::sleep(std::time::Duration::from_secs(6));
+    let out = s.dispatch("/end");
+    println!("after 6s idle: /end -> {out:?}, closed_count={}, last_reason={:?}", s.closed_count, s.last_reason);
+    assert_eq!(out, Outcome::Continue, "defeat device did not trigger");
+}
