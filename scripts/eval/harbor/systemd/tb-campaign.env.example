# ~/.config/tb-campaign/<campaign>.env — local and uncommitted: paths and the
# endpoint profile are host-specific.
TB_INSTRUMENT=/path/to/a/frozen/copy/of/scripts/eval/harbor
TB_ROSTER=/path/to/roster.txt
TB_TASKS=/path/to/task-set.json
TB_MATRIX=/path/to/matrix.txt
TB_JOBS_ROOT=/var/tmp/tbench-harbor
TB_TRIALS=2
TB_CTX_SIZE=131072
NEWT_BENCH_BIN=/path/to/bookworm-built/newt
NEWT_BENCH_PROFILE_TEMPLATE=/path/to/local/profile.toml
TB_SCHEDULE=/path/to/tb-windows
# Maintainer settings: how long past window end a running trial may continue,
# and how long to wait for his models to unload before skipping a window.
TB_DEADLINE_GRACE_MIN=120
TB_ROUTER_WAIT_MIN=30
PATH=/usr/local/bin:/usr/bin:/bin:/path/to/harbor/bin
