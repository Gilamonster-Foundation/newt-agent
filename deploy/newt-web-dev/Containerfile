# newt-web-dev — the repurposed drake-interactive image (decision D5,
# docs/decisions/newt_web_htmx.md). Dev/test box for newt-agent + newt-web:
# sshd + tmux + rust toolchain + the newt build deps + the cockpit binary.
#
# IDENTITY IS NEVER BAKED IN: host keys mount from the
# drake-interactive-hostkeys Secret; entrypoint.sh stages them 0600 (fsGroup
# makes Secret files group-readable, which sshd refuses).
#
# SUPPLY-CHAIN POSTURE (review, 2026-08-15): the base is digest-pinned, all
# downloaded artifacts (just and Herdr) are sha256-verified per-arch, and the
# deploy script rolls by image DIGEST — what was attested is what runs.

# Stage 1: build newt-web INSIDE the image lineage so glibc always matches.
FROM rust:1-bookworm@sha256:77fac8b98f9f46062bb680b6d25d5bcaabfc400143952ebc572e924bcbedc3fa AS builder
WORKDIR /src
COPY --from=agent_mesh . /agent-mesh
COPY . .
RUN CARGO_TARGET_DIR=/build cargo build --release --manifest-path newt-web/Cargo.toml

FROM rust:1-bookworm@sha256:77fac8b98f9f46062bb680b6d25d5bcaabfc400143952ebc572e924bcbedc3fa

RUN apt-get update && apt-get install -y --no-install-recommends \
        openssh-server tmux git ripgrep curl jq \
        pkg-config libssl-dev sqlite3 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd \
    && useradd -m -s /bin/bash -u 1000 drake

# `just` is not in bookworm's apt — fetch the pinned release and VERIFY it
# before executing anything (per-arch checksum; unsupported arches fail loudly
# rather than shipping a lying multi-platform file).
ARG TARGETARCH=amd64
ARG JUST_VERSION=1.40.0
RUN set -eux; \
    case "$TARGETARCH" in \
      amd64) just_arch="x86_64-unknown-linux-musl"; \
             just_sha="181b91d0ceebe8a57723fb648ed2ce1a44d849438ce2e658339df4f8db5f1263" ;; \
      arm64) just_arch="aarch64-unknown-linux-musl"; \
             just_sha="d065d0df1a1f99529869fba8a5b3e0a25c1795b9007099b00dfabe29c7c1f7b6" ;; \
      *) echo "unsupported TARGETARCH=$TARGETARCH" >&2; exit 1 ;; \
    esac; \
    curl --proto '=https' --tlsv1.2 -fsSLo /tmp/just.tar.gz \
      "https://github.com/casey/just/releases/download/${JUST_VERSION}/just-${JUST_VERSION}-${just_arch}.tar.gz"; \
    echo "${just_sha}  /tmp/just.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/just.tar.gz -C /usr/local/bin just; \
    rm -f /tmp/just.tar.gz; \
    /usr/local/bin/just --version

# Keep Herdr available as an operator-invoked multiplexer; SSH still opens the
# normal login shell and never auto-attaches to a Herdr session.
ARG HERDR_VERSION=0.8.0
RUN set -eux; \
    case "$TARGETARCH" in \
      amd64) herdr_arch="x86_64"; \
             herdr_sha="b872ea7e40fa2cb17e857ac9b62b1bf26db7b403c622f5d2f3f5b35f6e9acd28" ;; \
      arm64) herdr_arch="aarch64"; \
             herdr_sha="f647ac66468d9efbc642fe534fb284468f0aea60641606fc008dfc0d82a3ca87" ;; \
      *) echo "unsupported TARGETARCH=$TARGETARCH" >&2; exit 1 ;; \
    esac; \
    curl --proto '=https' --tlsv1.2 -fsSLo /usr/local/bin/herdr \
      "https://github.com/herdrdev/herdr/releases/download/v${HERDR_VERSION}/herdr-linux-${herdr_arch}"; \
    echo "${herdr_sha}  /usr/local/bin/herdr" | sha256sum -c -; \
    chmod 0755 /usr/local/bin/herdr; \
    /usr/local/bin/herdr --version

# No HostKey generation: keys arrive via the Secret + entrypoint staging.
RUN rm -f /etc/ssh/ssh_host_*_key* \
    && printf '%s\n' \
        'PasswordAuthentication no' \
        'PermitRootLogin no' \
        'AuthorizedKeysFile /etc/drake-interactive/authorized_keys' \
        > /etc/ssh/sshd_config.d/newt-web-dev.conf

# The cockpit binary from the builder stage (glibc-matched).
COPY --from=builder /build/release/newt-web /usr/local/bin/newt-web
COPY deploy/newt-web-dev/entrypoint.sh /entrypoint.sh

EXPOSE 22 8880
CMD ["/entrypoint.sh"]

# Model: not exposed by harness | Harness: Codex | Operator: Shawn Hartsock | Time: 12:33 UTC | Date: 2026-08-15
