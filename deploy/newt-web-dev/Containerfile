# newt-web-dev — the repurposed drake-interactive image (decision D5,
# docs/decisions/newt_web_htmx.md). Dev/test box for newt-agent + newt-web:
# sshd + tmux + rust toolchain + the newt build deps.
#
# IDENTITY IS NEVER BAKED IN. The registered SSH host keys mount from the
# `drake-interactive-hostkeys` Secret at runtime (the old image baked decoy
# keys at build time — root@buildkitsandbox — while sshd served a second set
# from the home PVC; this image ends that split). authorized_keys mounts from
# `drake-interactive-keys`. Tear down and rebuild freely: the identity is
# cluster-side.
# Stage 1: build newt-web INSIDE the image lineage so glibc always matches
# (a host-built binary from a newer distro dies with `GLIBC_x.y not found`).
# Context = the repo root (see build-and-roll.sh); .dockerignore keeps it lean.
FROM rust:1-bookworm AS builder
WORKDIR /src
COPY . .
RUN CARGO_TARGET_DIR=/build cargo build --release --manifest-path newt-web/Cargo.toml

FROM rust:1-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
        openssh-server tmux git ripgrep curl jq \
        pkg-config libssl-dev sqlite3 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd \
    && useradd -m -s /bin/bash -u 1000 drake

# `just` is not in bookworm's apt — install the prebuilt binary (pinned).
RUN curl -fsSL https://github.com/casey/just/releases/download/1.40.0/just-1.40.0-x86_64-unknown-linux-musl.tar.gz \
        | tar -xz -C /usr/local/bin just \
    && just --version

# No HostKey generation: /etc/ssh/ssh_host_* arrive as Secret mounts.
RUN rm -f /etc/ssh/ssh_host_*_key* \
    && printf '%s\n' \
        'PasswordAuthentication no' \
        'PermitRootLogin no' \
        'AuthorizedKeysFile /etc/drake-interactive/authorized_keys' \
        > /etc/ssh/sshd_config.d/newt-web-dev.conf

# The cockpit binary from the builder stage (glibc-matched).
COPY --from=builder /build/release/newt-web /usr/local/bin/newt-web

EXPOSE 22 8880
# Host keys arrive as a Secret mounted at /run/hostkeys. fsGroup makes Secret
# files group-readable (0640) and sshd refuses that, so the CMD installs them
# 0600 into /etc/ssh before exec'ing sshd (-D foreground, -e stderr).
# newt-web runs alongside sshd (dev-box supervision: if the cockpit dies the
# box lives; restart it over SSH or re-roll). Bind comes from NEWT_WEB_BIND
# (the Deployment opts into the LAN bind, D3).
CMD ["/bin/sh", "-c", \
     "install -m 600 -o root -g root /run/hostkeys/ssh_host_* /etc/ssh/ && (su drake -c 'RUST_LOG=info NEWT_WEB_BIND=\"${NEWT_WEB_BIND:-127.0.0.1:8880}\" /usr/local/bin/newt-web' &) && exec /usr/sbin/sshd -D -e -h /etc/ssh/ssh_host_ed25519_key -h /etc/ssh/ssh_host_rsa_key"]
