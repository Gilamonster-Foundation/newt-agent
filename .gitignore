# Live Testing
typescript*
*.log
# Rust
/target
# newt-mesh is a sibling crate outside the workspace; its target dir
# lives under newt-mesh/ rather than the workspace root.
/newt-mesh/target
**/*.rs.bk
Cargo.lock.bak

# Coverage output (Step 0.1 — justfile cov / cov-ci targets)
/lcov.info
/llvm-cov-*.profraw

# Python / maturin
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
.pytest_cache/

# Editor
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# TypeScript / Node
*.ts
*.js
*.mjs
*.cjs
# …but the dock drive harness (newt-web-drive.yml) SHIPS a Node stub Ollama +
# any JS helpers it drives; the blanket ignores above must not swallow them or
# the "dock lifecycle (tmux TUI + cockpit)" E2E aborts at start_stub on every
# clean checkout (CI included). Keep the drive harness's committed assets.
!/newt-web/tests/drive/*.mjs
!/newt-web/tests/drive/*.cjs
!/newt-web/tests/drive/*.js
node_modules/
dist/
*.tsbuildinfo
tsconfig.json
package.json
package-lock.json

# Eval analysis workflow TEMPLATES are canonical, committed sources (#805) —
# carve them out of the blanket *.js ignore above.
!scripts/eval/workflows/*.workflow.js
# Vendored browser assets are SOURCE, not build output. newt-web include_str!'s
# them and hashes them for SRI, so an ignored asset silently breaks the build
# for everyone but the author (#1372).
!newt-web/assets/*.js
# newt-web has no browser build step, but its headless BAT/UAT harness is
# committed JavaScript with a pinned Playwright test-only dependency.
!newt-web/package.json
!newt-web/package-lock.json
!newt-web/playwright.config.mjs
!newt-web/tests/headless/
!newt-web/tests/headless/*.mjs
/newt-web/playwright-report/
/newt-web/test-results/

# ...but the reconstituted Claude Code commands are GENERATED artifacts:
# scripts/eval/workflows/install.sh recreates them on any fresh machine.
/.claude/workflows/

# Research source PDFs — large binaries; we commit the synthesis notes, not the
# papers themselves (cite the arXiv id instead). See docs/research/*.md.
docs/research/*.pdf

# Local config / secrets — never commit
.env
.env.local
*.token
~/.newt/

# Newt ephemeral scratch (#844): crew worktrees, the crew cargo target, and
# per-session plans all live under `.scratch/`, which `.newt/` no longer holds.
# The harness ALSO writes a self-ignoring `.scratch/.gitignore` (`*`) whenever it
# creates scratch (newt_core::scratch::ensure_scratch), so scratch is ignored
# even if this root entry is removed — the model can't forget it.
/.scratch/

# Retired: session state moved from `.newt/sessions/` to `.scratch/sessions/`
# (#844). Kept briefly so any lingering old dir stays ignored during migration.
/.newt/sessions/

# trybuild writes proposed .stderr snapshots here when a UI test's expected
# output drifts (newt-core/tests/ui/). Review and move them into tests/ui/;
# never commit the scratch dir.
wip/

# Cursor agent test target (local)
target-cursor-tests/
.worktrees/
