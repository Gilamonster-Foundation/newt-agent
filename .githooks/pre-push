#!/bin/bash
#
# Pre-push hook for newt-agent
#
# Runs the same lint + test + coverage gates that CI runs, locally,
# before any push reaches origin. If this passes, CI should pass too
# — and if it doesn't, fix the issue here instead of burning a CI run.
#
# Install: `just install-hooks` (or `git config core.hooksPath .githooks`)
#
# PIPELINE PARITY: This hook mirrors .github/workflows/ci.yml.
#   - `just check` matches the lint + test + lean-build jobs (fmt + clippy +
#     cargo test, plus the `--no-default-features` lean build for issue #416 —
#     rich-tui is a default feature now, so the main jobs already cover it —
#     plus the #1409 lean TEST firewall: `cargo test -p newt-agent
#     --no-default-features`, `cargo test -p newt-tui`, and (#1828) `cargo
#     test -p newt-interaction --no-default-features` for the inward protocol
#     layer. The newt-tui line is the
#     lean surface's own suite: newt-tui declares no `default` features, so
#     testing it package-alone strips rich-tui + live-spill, which the
#     workspace build always unifies back on.)
#   - `just check` also runs `scripts/docs_check.py --self-test` and the
#     check itself, plus the `--deleted-refs origin/main` retirement sweep,
#     matching the "documentation references resolve (docs-check)" and
#     "deleted documents are not still referenced" steps in the lint job: every relative markdown link (repo
#     root + docs/**) resolves, and every `docs/....md` cited from a Rust
#     comment exists. Cheap (~0.1s); the self-test guards the scanner itself.
#   - `just cov-ci` matches the coverage job (cargo llvm-cov with floor)
#   - `just audit` matches the "Security audit" job (cargo audit against the
#     tracked ignore-list in .cargo/audit.toml; local best-effort if cargo-audit
#     is absent — CI is the hard gate)
#   - `just msrv` matches the "MSRV (Rust 1.88)" job (cargo +1.88 check; local
#     best-effort, needs rustup + the 1.88 toolchain — CI is the hard gate)
# When editing this hook, update the workflow to match.
# When editing the workflow, update this hook to match.
#
# Do NOT skip this hook with `--no-verify`. If a check fails, fix the
# issue. The hook is the local equivalent of CI; bypassing it just
# moves the failure to the remote.
#
# TRANSPORT (#276): this gate takes ~10 minutes, and that is INCOMPATIBLE
# with pushing over SSH. For SSH remotes git opens the connection and
# reads the advertised refs BEFORE running this hook (the hook's stdin
# carries the remote SHAs), then sends the pack over that SAME connection
# afterwards — by which time GitHub has dropped the idle session, and git
# exits 141 (SIGPIPE) after the gate passed. Over HTTPS the pack upload
# is a fresh request after the hook, so gate duration is irrelevant.
# `just install-hooks` therefore sets a repo-local
#   url."https://github.com/".pushInsteadOf "git@github.com:"
# so pushes transport over HTTPS while fetches keep their configured URL.
# HTTPS push auth comes from a git credential helper; if pushes prompt
# for a password, run `gh auth setup-git` once.

set -e

# Capture the ref list git writes to the hook's stdin (one
# "<local-ref> <local-sha> <remote-ref> <remote-sha>" line per ref). The
# network-leak guard below scans the pushed range; the cargo/coverage gates
# ignore it (they gate the whole workspace). Consuming stdin here is also
# standard hook hygiene: git must never take SIGPIPE writing refs to a hook
# that exited without reading, and the gate commands must not inherit it.
REFS="$(cat)"

cd "$(git rev-parse --show-toplevel)"

# Git exports its hook-time repo environment (GIT_DIR is an *absolute* path
# when pushing from a linked worktree) into this process, and it leaks into
# `cargo test`: integration tests that drive `git` inside temp repos
# (newt-core/tests/workspace_key.rs) then operate on THIS repo instead of
# their temp repo and fail. CI never runs under hook env, so parity is
# unaffected — drop the leak so the gates see the same world CI does.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

# ── Network-leak guard (privacy/security) ─────────────────────────────────────
# This repo is PUBLIC. Refuse to push internal/private network details — they
# turn a famous repo into a recon map for attacking the operator's home network,
# and a history rewrite can't recall what's already cloned/cached. Scans ONLY the
# ADDED lines in the commits being pushed. Mirrors the `pr-pre-review` skill.
# Use RFC5737 TEST-NET (192.0.2.x / 198.51.100.x / 203.0.113.x) or a placeholder
# in examples, and keep real values in ~/.newt. Do NOT bypass with --no-verify.
NET_LEAK_RE='(\b10\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\b)|(\b192\.168\.[0-9]{1,3}\.[0-9]{1,3}\b)|(\b172\.(1[6-9]|2[0-9]|3[01])\.[0-9]{1,3}\.[0-9]{1,3}\b)|(\b100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.[0-9]{1,3}\.[0-9]{1,3}\b)|(\b169\.254\.[0-9]{1,3}\.[0-9]{1,3}\b)|([A-Za-z0-9_-]+\.(home\.(lan|lab)|ts\.net)\b)|(tail[a-z0-9]+\.ts\.net)'
# Allowed: RFC5737 TEST-NET, loopback/unspecified, and the canonical generic
# private examples (10.0.0.1 etc.) that tests/docs legitimately need (e.g. the
# notes-scanner's RFC-1918 locality fixture). These reveal no home topology.
NET_LEAK_ALLOW='192\.0\.2\.|198\.51\.100\.|203\.0\.113\.|127\.0\.0\.1|0\.0\.0\.0|\b10\.0\.0\.1\b|\b192\.168\.0\.1\b'
_leaks=""
while read -r _lref _lsha _rref _rsha; do
    [ -z "$_lsha" ] && continue
    case "$_lsha" in *[!0]*) ;; *) continue ;; esac   # all-zero local = branch delete
    case "$_rsha" in
        *[!0]*) _range="$_rsha..$_lsha" ;;            # update: only the new commits
        *)      _range="origin/main...$_lsha" ;;      # new branch: changes since it forked main
    esac
    # Exclude .githooks/ — these scripts legitimately contain the IP/DNS regex.
    _hits="$(git diff "$_range" -- . ':(exclude).githooks/*' 2>/dev/null \
             | grep -E '^\+' | grep -vE '^\+\+\+' \
             | grep -nEi "$NET_LEAK_RE" | grep -vEi "$NET_LEAK_ALLOW" || true)"
    [ -n "$_hits" ] && _leaks="$_leaks
[$_lref]
$_hits"
done <<EOF
$REFS
EOF
if [ -n "$_leaks" ]; then
    echo "[pre-push] ✗ NETWORK-LEAK GUARD — refusing to push internal/private network details:"
    echo "$_leaks" | head -30
    echo "  → Replace with a TEST-NET example (192.0.2.x) or a placeholder; keep the real"
    echo "    value in ~/.newt. This repo is public — protect the home network. No --no-verify."
    exit 1
fi
# ──────────────────────────────────────────────────────────────────────────────

# Ensure ~/.cargo/bin is on PATH so cargo sub-commands are found even when
# the hook is invoked from an editor or GUI that doesn't source ~/.zshrc.
export PATH="$HOME/.cargo/bin:$PATH"

if ! command -v just >/dev/null 2>&1; then
    echo "pre-push: 'just' not found in PATH"
    echo "          install via: cargo install just"
    exit 1
fi

if ! command -v cargo-llvm-cov >/dev/null 2>&1; then
    echo "pre-push: 'cargo-llvm-cov' not found in PATH"
    echo "          install via: cargo install cargo-llvm-cov"
    exit 1
fi

# Coverage gate: only runs when rustup llvm-tools-preview is available.
# Homebrew Rust ships with a different LLVM version that reports ~6% lower
# line coverage for this codebase than the CI's rustup toolchain, causing
# spurious floor failures on macOS Homebrew installs. In that case, CI
# (GitHub Actions, which uses rustup) remains the authoritative gate.
SKIP_COV=0
if command -v rustup >/dev/null 2>&1; then
    # rustup available — ensure llvm-tools-preview is installed.
    if ! cargo llvm-cov --version >/dev/null 2>&1; then
        echo "pre-push: rustup is present but llvm-tools-preview is not installed."
        echo "          install via: rustup component add llvm-tools-preview"
        exit 1
    fi
else
    # No rustup (e.g. Homebrew Rust). Warn and skip coverage locally.
    echo "[pre-push] WARNING: rustup not found (Homebrew Rust detected)."
    echo "           Coverage gate skipped locally — CI is the authoritative gate."
    echo "           To run coverage locally: install Rust via rustup and run:"
    echo "             rustup component add llvm-tools-preview"
    SKIP_COV=1
fi

# Guard: never push a build patched onto the real brush shell (agent-bridle
# `main`) — it reintroduces the brush git dep and breaks crates.io publish.

echo "[pre-push] running just check..."
just check

echo "[pre-push] running just audit..."
just audit

echo "[pre-push] running just msrv..."
just msrv

if [ "$SKIP_COV" -eq 0 ]; then
    echo "[pre-push] running just cov-ci..."
    just cov-ci
fi

echo "[pre-push] OK"
