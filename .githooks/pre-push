#!/bin/bash
#
# Pre-push hook for newt-agent (#1098: fast pre-flight on the CHANGED scope)
#
# CRAFT-14 ("Hooks pre-flight what changed", Craft Register v3.0): this hook
# runs the pipeline's *kinds* of check -- format, lint, test -- on the files
# in the push, the crates that own them, and their reverse dependents. CI
# stays the authoritative FULL gate; nothing merges without it green.
#
# Install: `just install-hooks` (or `git config core.hooksPath .githooks`)
#
# SCOPED HERE (every push, on the changed crates only):
#   - the network-leak guard (privacy; file-scoped to the pushed diff)
#   - scripts/changed-scope.sh classification (NONE / ALL / <crates>)
#   - `cargo fmt --all -- --check` (whole tree; fast enough that scoping
#     buys nothing)
#   - `cargo clippy -D warnings --all-targets` on the changed crates plus
#     their TRANSITIVE reverse dependents (`--workspace` when classification
#     says ALL; otherwise scripts/reverse_deps.py computes the closure from
#     `cargo metadata` once and both clippy and the no-nextest fallback
#     below use that same expanded `-p` set)
#   - `cargo nextest run -E 'rdeps(<crate>) + ...'` on the same crate set,
#     minus the CI-only binaries named below (falls back to `cargo test -p
#     <crate>` per the expanded set above if nextest is missing; that
#     fallback has no per-binary exclusion and runs them)
#   - `python3 scripts/spawn_inventory.py` (~0.2s, whole tree -- matches
#     CI's spawn-inventory step; cheap enough to run unscoped every push)
#   - `just docs-check` (~0.5s, whole tree -- matches the lint job's
#     docs-check steps; cheap enough to run unscoped every push)
#   - a documentation-only push (or one that resolves to no crates) skips
#     the cargo gates and runs `just docs-check` alone
#
# CI-ONLY (never run here -- too slow, or needs infrastructure a dev box
# lacks; each of these is named so CRAFT-14's "scoped in the hook or named
# as CI-only" rule holds for every check the pipeline runs):
#   - `just cov-ci` (coverage floor, cargo-llvm-cov instrumented whole-workspace)
#   - the `--no-default-features` lean build/test config (issue #416, #1409, #1828)
#   - `just msrv` (MSRV toolchain check)
#   - `just audit` (cargo-audit against .cargo/audit.toml)
#   - `just eval-selftest` (bench/harbor fixture suite)
#   - `just harness-python` (uv + CPython real-resource lane)
#   - the PTY (newt-tui-pty.yml) and mcp-import-real.yml real-resource lanes
#   - the real-`newt`-session and real-PTY integration binaries of the
#     newt-agent package (newt-cli/tests/), filtered out of the nextest run
#     by name (NEXTEST_EXCLUDE below). CLAUDE.md "Testing strategy" puts
#     real-subprocess / real-PTY tests in the EXPENSIVE tier: CI and release
#     gates, never per-push. Each one spawns the real debug `newt` for actual
#     CLI startup (backend probe, herdr socket, git config -- ~6 s at idle)
#     behind a fixed wall-clock bound, and under this hook's parallel nextest
#     run on a loaded dev box they cross it and reject the push (measured:
#     three rejections on 2026-09-30, all in this shape, every one green in
#     CI on the same SHA). CI's `test` job runs all six on every PR via
#     `cargo test --workspace` (the `windows` job runs the three that are
#     not `#![cfg(unix)]`); terminal_exit_pty also runs in newt-tui-pty.yml.
#       newt-agent::lean_surface_purity  lean-surface byte contract; six
#                                         `newt` sessions per test, 30 s cap
#       newt-agent::stdout_purity        real `newt worker` / `newt mcp`, 10 s
#       newt-agent::posture_turn         real chat loop, 30 s
#       newt-agent::personality_turn     real chat loop, 60 s
#       newt-agent::migration_notices    real CLI startup, 20-30 s
#       newt-agent::terminal_exit_pty    real PTY + CLI startup, 30 s budget
#   - two more real-resource lanes, same tier as the six above (#2663 named
#     the six real-`newt`-session binaries but missed these -- measured in
#     the push rejections of 2026-10-01/02):
#       newt-eval::mock_e2e                        builds the real `newt`
#                                                    worker binary once
#                                                    (worker_under_test) and
#                                                    spawns it per bundled
#                                                    case (golden_mcp_handshake
#                                                    _boundary,
#                                                    all_bundled_cases_pass_in
#                                                    _mock_mode, and the rest
#                                                    of the file) -- excluded
#                                                    whole-binary, like the six
#                                                    above, because every test
#                                                    in it shares that cost.
#       newt-tui::prompt_visibility_test (2 tests)  a real PTY, not a whole
#                                                    binary -- the module
#                                                    lives inside newt-tui's
#                                                    lib unit-test binary
#                                                    alongside ~1,360 fast
#                                                    tests, so NEXTEST_EXCLUDE
#                                                    names the two slow tests
#                                                    by exact test() match
#                                                    instead of excluding the
#                                                    whole binary_id:
#                                                      mcp_net_prompt_enter_confirms_configured_default_on_a_real_terminal
#                                                      a_permission_prompt_is_visible_and_survives_a_live_spinner
#                                                    (the module's own
#                                                    strip_ansi_tests are pure
#                                                    string checks and stay in
#                                                    the per-push run.)
#     CI's `test` job runs both on every PR via its unchanged `cargo test
#     --workspace` step -- no ci.yml edit needed, only this account and the
#     NEXTEST_EXCLUDE filter below.
#   - the npm installer matrix (test-npm, all three OS legs): this hook runs
#     no npm check on any OS -- ci.yml's test-npm job is the only gate;
#     `just npm-test` / `just check` are the by-hand local equivalents
#   - this hook's OWN regression suites (scripts/test_pre_push.py,
#     scripts/test_changed_scope.py, scripts/test_reverse_deps.py) --
#     running a hook's self-test from inside itself proves nothing; CI's
#     "push-hook ... regression" steps in the `lint` job are what gate them
#   - OCAP register honesty (`scripts/ocap_check.py`) and cross-language
#     conformance (`newt-interaction/conformance/newt_conformance.py`) --
#     both pure-Python but multi-invocation; the `lint` job's own steps
#   - the vendored crossterm regression (`vendor/crossterm-0.28.1-patched`,
#     `just check-vendor-crossterm`) -- outside the workspace the changed-
#     scope classifier maps against
#   - the `windows` and `musl` jobs (ci.yml) -- no Windows dev box / musl
#     cross-target+musl-tools on a typical dev box; ci.yml's own top comment
#     names these as the same kind of exception
#   - rust-stable-canary.yml (weekly floating-stable clippy; warns of an
#     upcoming pin bump before it blocks PRs — never a push gate; see that
#     workflow's own HOOK PARITY comment)
#   - every workflow that provides its own non-standard checkout or
#     toolchain and says so in its own HOOK PARITY comment: newt-web.yml /
#     newt-web-drive.yml (excluded newt-mesh crate + browser install),
#     mesh-integration.yml (sibling agent-mesh checkout), formal.yml /
#     behavior-formal.yml (Lean/JDK toolchain), behavior-registry.yml (its
#     Rust-source trigger is cheap but still a separate workflow, not a
#     hook-shaped pre-flight)
#
# RETRIES: nextest runs with `--retries 2`. Several newt-core tests carry
#   wall-clock budgets (driver pump, stream loops) that pass in well under a
#   second alone but can exceed their budget when this hook's full parallel run
#   shares a loaded dev box. A test that passes on retry is reported FLAKY in
#   nextest's summary (visible, not hidden); one that fails every attempt still
#   fails the hook. CI stays the authoritative full gate.
#
# PIPELINE PARITY: This hook mirrors .github/workflows/ci.yml -- see that
# file's HOOK PARITY comment for the job-by-job mapping. Editing either one
# triggers an audit of the other (CRAFT-14 rule 3, Push Hook Governance
# rule 3).
#
# When editing this hook, update the workflow to match.
# When editing the workflow, update this hook to match.
#
# Do NOT skip this hook with `--no-verify`. If a check fails, fix the
# issue. CI is the authoritative full gate; this hook is the fast
# pre-flight that keeps you from burning a CI run on an easy miss.
#
# TRANSPORT (#276): a slow gate is incompatible with pushing over SSH (git
# opens the connection and reads advertised refs BEFORE running this hook,
# then sends the pack over that SAME connection afterwards -- by which time
# GitHub may have dropped the idle session). `just install-hooks` sets a
# repo-local `url."https://github.com/".pushInsteadOf "git@github.com:"` so
# pushes transport over HTTPS while fetches keep their configured URL.
# HTTPS push auth comes from a git credential helper; if pushes prompt for
# a password, run `gh auth setup-git` once.

set -e

# Capture the ref list git writes to the hook's stdin (one
# "<local-ref> <local-sha> <remote-ref> <remote-sha>" line per ref). Both the
# network-leak guard and scripts/changed-scope.sh need this, and git must
# never take SIGPIPE writing refs to a hook that exited without reading.
REFS="$(cat)"

cd "$(git rev-parse --show-toplevel)"

# Git exports its hook-time repo environment (GIT_DIR is an *absolute* path
# when pushing from a linked worktree) into this process, and it leaks into
# `cargo test`: integration tests that drive `git` inside temp repos
# (newt-core/tests/workspace_key.rs) then operate on THIS repo instead of
# their temp repo and fail. CI never runs under hook env, so parity is
# unaffected -- drop the leak so the gates see the same world CI does.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

# ── Network-leak guard (privacy/security) ─────────────────────────────────────
# This repo is PUBLIC. Refuse to push internal/private network details — they
# turn a famous repo into a recon map for attacking the operator's home network,
# and a history rewrite can't recall what's already cloned/cached. Scans ONLY the
# ADDED lines in the commits being pushed. Mirrors the `pr-pre-review` skill.
# Use RFC5737 TEST-NET (192.0.2.x / 198.51.100.x / 203.0.113.x) or a placeholder
# in examples, and keep real values in ~/.newt. Do NOT bypass with --no-verify.
NET_LEAK_RE='(\b10\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\b|\b192\.168\.[0-9]{1,3}\.[0-9]{1,3}\b|\b172\.(1[6-9]|2[0-9]|3[01])\.[0-9]{1,3}\.[0-9]{1,3}\b|\b100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.[0-9]{1,3}\.[0-9]{1,3}\b|\b169\.254\.[0-9]{1,3}\.[0-9]{1,3}\b)(/[0-9]+)?|[A-Za-z0-9_-]+\.(home\.(lan|lab)|ts\.net)\b|tail[a-z0-9]+\.ts\.net'
# Filter individual matches, never whole lines: a public example must not hide
# a private neighbor. TEST-NET, loopback and unspecified addresses do not match
# above. Retain the generic private examples and recognize only the public AWS
# metadata constant (also in IPv4-mapped form) and exact RFC6598 range notation.
# These source constants reveal no home topology; this grants no network access.
NET_LEAK_ALLOW='10\.0\.0\.1|192\.168\.0\.1|169\.254\.169\.254|100\.64\.0\.0/10'
_leaks=""
_changed=""
while read -r _lref _lsha _rref _rsha; do
    [ -z "$_lsha" ] && continue
    case "$_lsha" in *[!0]*) ;; *) continue ;; esac   # all-zero local = branch delete
    case "$_rsha" in
        *[!0]*) _range="$_rsha..$_lsha" ;;            # update: only the new commits
        *)      _range="origin/main...$_lsha" ;;      # new branch: changes since it forked main
    esac
    # Keep the complete update for gate selection, including upstream changes
    # brought in by a rebase (see the documentation-only gate below).
    _changed="$_changed
$(git diff --name-only "$_range" 2>/dev/null || true)"
    _leak_range="$_range"
    # A rebased branch reintroduces upstream lines in old-head..new-head even
    # though they are already public on main. Scan the feature additions only
    # when BOTH ancestry checks prove this case; errors are not divergence.
    # Gate selection above stays conservative, and the privacy patterns stay
    # unchanged. New private lines on the rebased branch still fail below.
    _ancestor_status=0
    git merge-base --is-ancestor "$_rsha" "$_lsha" 2>/dev/null || _ancestor_status=$?
    if [ "$_ancestor_status" -eq 1 ] && git merge-base --is-ancestor origin/main "$_lsha" 2>/dev/null; then
        _leak_range="origin/main..$_lsha"
    fi
    # Exclude .githooks/ — these scripts legitimately contain the IP/DNS regex.
    # Python is also required by the existing docs/test gates. Scanner errors,
    # a missing interpreter, and unreadable diffs must fail closed, not look
    # like an empty set of matches. Pipefail covers the producer as well.
    if ! _hits="$(set -o pipefail
        git diff "$_leak_range" -- . ':(exclude).githooks/*' \
            | python3 -c '
import re
import sys

private = re.compile(sys.argv[1], re.IGNORECASE)
allowed = re.compile(sys.argv[2], re.IGNORECASE)
added_line = 0
# Git diffs may contain arbitrary bytes; make scan behavior independent of
# the locale and PYTHONIOENCODING without discarding those bytes.
for raw_line in sys.stdin.buffer:
    line = raw_line.decode("utf-8", errors="surrogateescape")
    if not line.startswith("+") or line.startswith("+++"):
        continue
    added_line += 1
    for match in private.finditer(line):
        token = match.group()
        if allowed.fullmatch(token):
            if token == "100.64.0.0/10":
                before = line[match.start() - 1:match.start()]
                after = line[match.end():match.end() + 1]
                # A URL path or IPv6 suffix is not RFC6598 range notation.
                # Nor may a longer CIDR/token inherit this exact exception.
                if before in ("/", ":", "@") or (after and (after.isalnum() or after in "._/-")):
                    print(f"{added_line}:{line}", end="")
                    break
            continue
        print(f"{added_line}:{line}", end="")
        break
' "$NET_LEAK_RE" "$NET_LEAK_ALLOW")"; then
        echo "[pre-push] network-leak scan failed; refusing to push without a complete privacy check."
        exit 1
    fi
    [ -n "$_hits" ] && _leaks="$_leaks
[$_lref]
$_hits"
done <<EOF
$REFS
EOF
if [ -n "$_leaks" ]; then
    echo "[pre-push] ✗ NETWORK-LEAK GUARD — refusing to push internal/private network details:"
    echo "$_leaks" | head -30
    echo "  → Replace with a TEST-NET example (192.0.2.x) or a placeholder; keep the real"
    echo "    value in ~/.newt. This repo is public — protect the home network. No --no-verify."
    exit 1
fi
# ──────────────────────────────────────────────────────────────────────────────

# Ensure ~/.cargo/bin is on PATH so cargo sub-commands are found even when
# the hook is invoked from an editor or GUI that doesn't source ~/.zshrc.
export PATH="$HOME/.cargo/bin:$PATH"

# sccache: the S3 endpoint lives in ~/.config/sccache/config, and the SCCACHE_*
# environment variables OVERRIDE that file. Any long-lived parent — a terminal
# multiplexer's server process, a shell started before the endpoint moved —
# hands every child it spawns a stale endpoint, and a child that never sources
# a login profile has no chance to repair it.
#
# sccache does not degrade to plain rustc when its cache is unreachable: it
# FAILS THE BUILD. rustc exits 2 with NO diagnostics, which reads exactly like
# a compile error and gets misfiled as "the gate failed" against whatever
# change happened to be in flight. Observed 2026-09-09 against a dead
# 127.0.0.1:9000 inherited from a process older than the endpoint move.
#
# Drop the overrides so the config file is the single source of truth.
# Credentials (AWS_*) and RUSTC_WRAPPER are deliberately untouched — honour
# whatever wrapper/incremental settings the caller has (the gnuc sccache
# trap above is about a STALE endpoint override, not the wrapper itself).
unset SCCACHE_ENDPOINT SCCACHE_S3_USE_SSL SCCACHE_BUCKET SCCACHE_REGION

if ! command -v just >/dev/null 2>&1; then
    echo "pre-push: 'just' not found in PATH"
    echo "          install via: cargo install just"
    exit 1
fi

# ── Changed-scope classification (#1098) ───────────────────────────────────────
# scripts/changed-scope.sh reads the same ref list and prints:
#   (nothing) -- deletion, tag push, or docs-only: skip the cargo gates
#   ALL       -- a workspace-wide file changed: gate everything
#   <crates>  -- only these crates (and their reverse dependents) changed
SCOPE="$(printf '%s\n' "$REFS" | bash scripts/changed-scope.sh)"

if [ -z "$SCOPE" ]; then
    echo "[pre-push] no code-affecting change in this push — running just docs-check..."
    just docs-check
    echo "[pre-push] OK (docs-only or no-op push; cargo gates skipped)"
    exit 0
fi

echo "[pre-push] running python3 scripts/spawn_inventory.py..."
python3 scripts/spawn_inventory.py

echo "[pre-push] running just docs-check..."
just docs-check

echo "[pre-push] running cargo fmt --all -- --check..."
cargo fmt --all -- --check

# nextest's discovery model calls EVERY test binary with `--list [--format
# terse] [--ignored]` to enumerate tests before running any of them. `cargo
# test` never does this -- it invokes a harness=false binary directly and
# lets its own main() decide what to do. This repo has six `harness = false`
# custom-main test binaries (`grep -rn "harness = false" --include=Cargo.toml`),
# and #1098 is the first thing to ever run nextest against them. Two are
# confirmed broken by this real push (2026-09-30): newt-git::native_git_commit
# treats the mere PRESENCE of "--ignored" in argv as "run the real confined
# git test" (tests/native_git_commit.rs:11) instead of gating on an exact
# match, so nextest's discovery pass runs it for real outside a sandboxed CI
# runner; agent-harness::writer_inheritance ignores argv entirely and always
# runs its fork-based test (tests/writer_inheritance.rs:149), which then hits
# a broken pipe when nextest closes the child's stdout after the list request
# it never asked for. newt-core::brush_build_pipeline is excluded alongside
# them as a precaution -- same shape of custom main, not yet proven safe under
# nextest's discovery pass either, and cheap to exclude versus expensive to
# prove. The three vendored agent-bridle-tool-shell real-shell binaries
# (brush_real, carried_coreutils, named_host_root_real) need `required-features
# = ["brush"]` / `["carried-coreutils"]` this hook never enables, so they are
# never compiled here and must NOT be named in this filter -- nextest's
# `binary_id()` predicate hard-errors ("no binary IDs matched") on a name with
# zero matches in the discovered set, unlike `package()`. Fixing the three
# excluded binaries' arg handling is tracked separately; out of scope for
# #1098's hook-only change.
#
# What CI actually exercises for these three, named rather than assumed (fix-
# first review on #2658, finding P2/5 -- do not claim execution from mere
# compilation): the `test` job's `cargo test --workspace` (ci.yml) DOES
# compile and invoke all three main()s with no extra args, same as this
# hook's own no-nextest fallback above. Under that no-arg invocation,
# writer_inheritance always runs its real fork test (its main() ignores argv
# entirely) -- so CI's plain `cargo test --workspace` genuinely covers it.
# native_git_commit and brush_build_pipeline instead gate their real body on
# an exact `--ignored` match and print a one-line "... ignored" stub without
# it; grepping every workflow in .github/workflows/ for their test-binary
# names or an `-- --ignored` invocation that reaches them finds NONE. Their
# real bodies are therefore DISCLOSED GAPS, not covered anywhere in CI today
# -- `cargo test -p newt-git --test native_git_commit -- --ignored` and
# `cargo test -p newt-core --test brush_build_pipeline -- --ignored` need a
# real-resource CI lane of their own (tracked separately; out of scope here).
#
# The six newt-agent binaries are the real-`newt`-session / real-PTY tier;
# newt-eval::mock_e2e (whole binary) and the two named newt-tui tests are the
# same tier, added later: see the CI-ONLY list in the header for each one's
# reason and where CI runs it. scripts/test_pre_push.py pins this list;
# change both together.
NEXTEST_EXCLUDE='not binary_id(newt-core::brush_build_pipeline)
    and not binary_id(agent-harness::writer_inheritance)
    and not binary_id(newt-git::native_git_commit)
    and not binary_id(newt-agent::lean_surface_purity)
    and not binary_id(newt-agent::stdout_purity)
    and not binary_id(newt-agent::posture_turn)
    and not binary_id(newt-agent::personality_turn)
    and not binary_id(newt-agent::migration_notices)
    and not binary_id(newt-agent::terminal_exit_pty)
    and not binary_id(newt-eval::mock_e2e)
    and not (binary_id(newt-tui) and test(=prompt_visibility_test::mcp_net_prompt_enter_confirms_configured_default_on_a_real_terminal))
    and not (binary_id(newt-tui) and test(=prompt_visibility_test::a_permission_prompt_is_visible_and_survives_a_live_spinner))'

# nextest presence is probed the way cargo resolves subcommands (PATH plus
# $CARGO_HOME/bin) rather than with `command -v cargo-nextest`, so the hook's
# own regression suite can force the no-nextest fallback through its `cargo`
# stub on a box that has nextest installed (scripts/test_pre_push.py).
_have_nextest=0
cargo nextest --version >/dev/null 2>&1 && _have_nextest=1

if [ "$SCOPE" = "ALL" ]; then
    echo "[pre-push] changed scope: ALL (workspace-wide file changed)"
    echo "[pre-push] running cargo clippy --workspace --all-targets -- -D warnings..."
    cargo clippy --workspace --all-targets --features newt-data/kernel,newt-interaction/schema -- -D warnings
    if [ "$_have_nextest" = 1 ]; then
        echo "[pre-push] running cargo nextest run --workspace..."
        cargo nextest run --retries 2 -E "$NEXTEST_EXCLUDE" --features newt-data/kernel,newt-interaction/schema
    else
        echo "[pre-push] cargo-nextest not found; falling back to cargo test --workspace"
        cargo test --workspace --features newt-data/kernel,newt-interaction/schema
    fi
else
    echo "[pre-push] changed scope: $SCOPE"
    # nextest expands reverse dependents itself via `rdeps(...)`; clippy and
    # the no-nextest `cargo test` fallback have no such expression, so they
    # were silently missing them (fix-first review on #2658, finding P2 #1).
    # scripts/reverse_deps.py computes the identical transitive closure from
    # `cargo metadata` once, and both of those gates use it for `-p`.
    _expanded_scope="$(python3 scripts/reverse_deps.py $SCOPE)"
    _pkg_args=()
    _rdeps_expr=""
    for _crate in $_expanded_scope; do
        _pkg_args+=(-p "$_crate")
    done
    for _crate in $SCOPE; do
        if [ -z "$_rdeps_expr" ]; then
            _rdeps_expr="rdeps($_crate)"
        else
            _rdeps_expr="$_rdeps_expr + rdeps($_crate)"
        fi
    done

    # No --features here: `newt-data/kernel,newt-interaction/schema` is a
    # workspace-level feature unification CI enables for the FULL build (see
    # the ALL branch above), and `-p <crate>` rejects a feature path whose
    # crate isn't in the selected package set. The scoped pre-flight trades
    # that one axis of coverage for speed; CI still gates it on every PR.
    echo "[pre-push] running cargo clippy -- -D warnings for: $SCOPE (and reverse dependents)..."
    cargo clippy "${_pkg_args[@]}" --all-targets -- -D warnings

    if [ "$_have_nextest" = 1 ]; then
        echo "[pre-push] running cargo nextest run -E '$_rdeps_expr'..."
        cargo nextest run --retries 2 -E "($_rdeps_expr) and ($NEXTEST_EXCLUDE)"
    else
        echo "[pre-push] cargo-nextest not found; falling back to cargo test -p <crate> per crate"
        cargo test "${_pkg_args[@]}"
    fi
fi

echo "[pre-push] OK"
