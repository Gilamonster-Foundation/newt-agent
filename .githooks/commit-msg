#!/usr/bin/env bash
# commit-msg hook — keep two kinds of junk out of history:
#
# 1. Claude session URLs / trailers. A `Claude-Session: https://claude.ai/code/
#    session_…` trailer is agent-session plumbing, not repository provenance.
#    Once committed to a public repo it is cloned, forked, and cached forever.
#    It slipped into public history once (commit dc6a167). `Co-Authored-By:`
#    attribution is fine — only the session link is banned. See CLAUDE.md
#    "expunge Claude sessions". Check: scripts/check_session_url.sh.
#
# 2. Placeholder identities. An author or committer email with no dot in its
#    domain (`x@y`, `a@localhost`) is a placeholder; GitHub may link it to an
#    unrelated real account, which then appears as a contributor. Check:
#    scripts/check_commit_identity.sh.
#
# PIPELINE PARITY: This hook mirrors the `commit-messages` job in
# .github/workflows/ci.yml, which runs the same two scripts over a PR's
# commits — the copy `--no-verify` cannot skip. When editing this hook, update
# that job to match. It is orthogonal to .githooks/pre-push (lint/test gate).
set -euo pipefail

msg_file="$1"
scripts="$(git rev-parse --show-toplevel)/scripts"

ident_email() { git var "$1" | sed -n 's/.*<\(.*\)>.*/\1/p'; }

rc=0
"$scripts/check_session_url.sh" "$msg_file" || rc=1
"$scripts/check_commit_identity.sh" \
    "$(ident_email GIT_AUTHOR_IDENT)" "$(ident_email GIT_COMMITTER_IDENT)" || rc=1
[ "$rc" -eq 0 ] || echo "✗ commit blocked (see above)." >&2
exit "$rc"
